pkg_name="@PACKAGE_NAME@"
pkg_tarname="@PACKAGE_TARNAME@"
pkg_version="@PACKAGE_VERSION@"
pkg_url="@PACKAGE_URL@"

if [ "$pkg_name" = "@PACKAGE_NAME""@" ]; then
	pkg_name="dir-index.sh"
	pkg_tarname="dir-index-sh"
	pkg_version="dev"
	pkg_url="https://github.com/jefferyto/dir-index.sh"
fi

source="$0"
me="${source##*/}"
xdg_data_home="${XDG_DATA_HOME:-"$HOME"/.local/share}"
xdg_data_dirs="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
iso_8601_format="%Y-%m-%dT%H:%M:%S.%NZ"
nl="
"

date=
find=
jq=
mktemp=
numfmt=
readlink=
realpath=
sed=
sort=

force=
root_dirs_path=
root_dirs=
index_file_name=
index_format="html"
preserve_index_dir_mtime=1

ignore_patterns_path=
ignore_patterns=
ignore_args=
ignore_dot_files=1
ignore_html_includes=1

skip_patterns_path=
skip_patterns=
skip_args=
skip_dot_dirs=1
skip_ignore_patterns=

sort_column="name"
sort_desc=
name_version_sort=1
name_case_insensitive=
folders_first=

html_preamble=1
columns="name${nl}modified${nl}size" # newline delimited
num_columns=3
rule_lines=1
plain_list=
index_path_prefix=

title_text="Index of %s"
dir_text=
lang_text="en"
charset_text="utf-8"
head_text=
header_text="Index of %s"
breadcrumbs_root_text="Home"
readme_text="Generated by <a href=\"$pkg_url\" target=\"_blank\">$pkg_name</a> $pkg_version"

style_name=
style_path=
head_path=
header_path=
readme_path=

name_text="Name"
last_modified_text="Last modified"
size_text="Size"
parent_directory_text="Parent Directory"

size_unit="iec"
last_modified_format="%Y-%m-%d %H:%M"
last_modified_utc=

encoding_text="UTF-8"

# /usr/include/sysexits.h
ex_usage=64
ex_noinput=66
ex_unavailable=69

stdin_content=
is_stdin_read=
temp_dir=
now_text=
result=0

keyword=
path=
search_paths=
signal=
file_data=

# shellcheck disable=SC2329 # it's a trap!
clean_up() {
	local signal="$1"

	if [ -n "$temp_dir" ]; then
		rm -rf -- "$temp_dir"
	fi

	if [ "$signal" != "EXIT" ]; then
		trap - "$signal" # reset trap
		kill -s "$signal" -- "$$" # resend signal to self
	fi
}

print_stderr() {
	printf '%s: %s\n' "$me" "$*" >&2
}

usage() {
	cat <<- EOF
	Usage: $me [OPTION]... [DIR]...
	Generate directory index files for DIR(s) and subdirectories under
	DIR(s).

	General options:
	  -g FILE       read directories to index from FILE:
	                  * directories are delimited by NUL, not newline
	                  * if FILE is -, directories are read from standard
	                    input
	  -f            overwrite existing directory index files
	  -V            display version information and exit
	  -h            display this help text and exit

	Indexing options:
	  -i PATTERN    ignore files and directories matching shell PATTERN
	                when indexing a directory (can be used multiple times)
	  -I FILE       read ignore patterns from FILE:
	                  * patterns are delimited by NUL, not newline
	                  * if FILE is -, patterns are read from standard
	                    input
	  -T OPTIONS    comma-separated list of option keywords:
	                  * ignore-dot: ignore dot files (.*) (default)
	                  * no-ignore-dot: do not ignore dot files
	                  * ignore-includes: ignore files included with -E, -D
	                    or -R (see HTML-specific output options) (default)
	                  * no-ignore-includes: do not ignore files included
	                    with -E, -D or -R

	  -k PATTERN    skip directories matching shell PATTERN and their
	                subdirectories when searching for directories to index
	                (can be used multiple times)
	  -K FILE       read skip patterns from FILE:
	                  * patterns are delimited by NUL, not newline
	                  * if FILE is -, patterns are read from standard
	                    input
	  -W OPTIONS    comma-separated list of option keywords:
	                  * skip-dot: skip dot directories (.*) (default)
	                  * no-skip-dot: do not skip dot directories
	                  * skip-ignores: apply ignore patterns to skip
	                    directories
	                  * no-skip-ignores: do not apply ignore patterns to
	                    skip directories (default)

	  Ignore patterns (-i and -I) and skip patterns (-k and -K) match base
	  names only. If a path is given, all leading directories will be
	  removed from the pattern.

	Output options:
	  -o NAME       use NAME for directory index files
	  -O FORMAT     use FORMAT for directory index files:
	                  * valid values: html (default), xml, json

	  -s COLUMN     sort by COLUMN:
	                  * valid values: name (default), modified, size
	  -S OPTIONS    comma-separated list of option keywords:
	                  * asc: sort ascending (default)
	                  * desc: sort descending
	                  * version: enable version sort (default)
	                  * no-version: disable version sort
	                  * case: case-sensitive sort (default)
	                  * no-case: case-insensitive sort (requires
	                    no-version)
	                  * folders-first: list directories first
	                  * no-folders-first: list files and directories
	                    together (default)

	  -F            update directory mtimes when creating index files

	HTML-specific output options:
	  -y STYLE      use built-in STYLE:
	                  * none (default)
	                  * classic
	                  * classic-full

	  -t TITLE      use TITLE for page title (<title>)
	  -w DIR        use DIR for page text direction (<html dir="...">)
	  -l LANG       use LANG for page language (<html lang="...">)
	  -A CHARSET    specify CHARSET for <meta charset="...">
	  -e HTML       include HTML in <head> (can be used multiple times)

	  -d TEXT       use TEXT for header
	  -x TEXT       use TEXT for breadcrumbs root link
	  -r TEXT       use TEXT for readme

	  -E FILE       include content from FILE in <head>
	  -D FILE       include content from FILE in place of header
	  -R FILE       include content from FILE in place of readme

	                for -E, -D and -R:
	                  * FILE is a base name: for each directory to be
	                    indexed, if FILE exists in the directory then it
	                    will be included in that directory's index file
	                  * FILE is a path (relative or absolute): the file at
	                    that path will be included in every directory
	                    index file
	                  * FILE is -: content will read from standard input
	                    and included in every directory index file

	  -C COLUMNS    comma-separated list of columns to include:
	                  * valid values: name, modified, size

	  -N TEXT       use TEXT for file name column heading

	  -m FORMAT     use FORMAT for file last modified dates:
	                  * same syntax as 'date' command output format string
	  -u            output last modified dates in UTC
	  -M TEXT       use TEXT for last modified column heading

	  -z UNIT       use UNIT for file sizes:
	                  * none (exact size)
	                  * si (1k = 1000, 1M = 1000000, ...)
	                  * iec (1K = 1024, 1M = 1048576, ...) (default)
	                  * iec-i (1Ki = 1024, 1Mi = 1048576, ...)
	  -Z TEXT       use TEXT for size column heading

	  -P TEXT       use TEXT for parent directory link

	  -X PATH       index DIR as if it is located at PATH instead of at
	                web server root:
	                  * should be an absolute path
	  -H OPTIONS    comma-separated list of option keywords:
	                  * table: output directory listing as a table
	                    (default)
	                  * list: output directory listing as a list of names
	                    only
	                  * rules: output horizontal rule lines (<hr>) in
	                    index table (default)
	                  * no-rules: omit horizontal rule lines (<hr>) in
	                    index table
	                  * preamble: include opening and closing HTML
	                    (default)
	                  * no-preamble: omit opening HTML (<html>, <head>,
	                    etc.) when including file content with -D, and
	                    omit closing HTML (</body></html>) when including
	                    file content with -R

	XML-specific output options:
	  -G ENCODING   specify ENCODING in XML declaration
	                (<?xml encoding="..."?>)

	EOF
}

# true if $2 includes $1
str_includes() {
	[ -n "$2" ] && [ -z "${2##*"$1"*}" ]
}

# true if $2 starts with $1
str_starts_with() {
	[ -n "$2" ] && [ -z "${2##"$1"*}" ]
}

# true if $2 ends with $1
str_ends_with() {
	[ -n "$2" ] && [ -z "${2##*"$1"}" ]
}

escape_html() {
	"$jq" -sRj '@html'
}

encode_uri() {
	"$jq" -sRj '@uri' | "$sed" -e 's/%2[Ff]/\//g'
}

# includes enclosing quotation marks
encode_json_string() {
	"$jq" -sRj '@json'
}

format_last_modified() {
	"$date" ${last_modified_utc:+-u} -f - "+$last_modified_format"
}

format_date_iso_8601() {
	"$date" -u -f - "+$iso_8601_format"
}

ensure_readable_file() {
	if [ -n "$1" ] && [ "$1" != "-" ] && { [ ! -f "$1" ] || [ ! -r "$1" ]; }; then
		print_stderr "error: \"$1\" is not a readable file"
		exit "$ex_noinput"
	fi
}

set_quoted_arg() {
	local arg="$1"

	quoted_arg=
	while str_includes "'" "$arg"; do
		quoted_arg="$quoted_arg${arg%%\'*}'\\''"
		arg="${arg#*\'}"
	done
	quoted_arg="'$quoted_arg$arg'"
}

set_quoted_row_args() {
	local row="$1"
	local num_args="$2"
	local remove_prefix="$3"
	local i=1
	local arg=
	local quoted_arg=

	if [ -n "$remove_prefix" ]; then
		if str_starts_with "/./" "$row"; then
			row="${row#/./}"
		else
			row="${row#././}"
		fi
	fi

	quoted_row_args=

	while [ "$i" -le "$num_args" ]; do
		if [ "$i" -lt "$num_args" ] && str_includes "/" "$row"; then
			arg="${row%%/*}"
			row="${row#*/}"
		else
			arg="$row"
			row=
		fi
		set_quoted_arg "$arg"
		quoted_row_args="$quoted_row_args$quoted_arg "
		i="$((i + 1))"
	done
}

foreach_row() {
	local data="$1"
	local command="$2"
	local num_args="$3"
	local remove_prefix="$4"
	local result=0
	local line=
	local row=
	local quoted_row_args=
	local command_result=

	if [ -z "$data" ]; then
		return "$result"
	fi

	while IFS= read -r line; do
		if str_starts_with "/./" "$line" || str_starts_with "././" "$line"; then
			if [ -n "$row" ]; then
				set_quoted_row_args "$row" "$num_args" "$remove_prefix"
				eval "$command $quoted_row_args"
				command_result="$?"

				if [ "$command_result" -ne 0 ]; then
					result="$command_result"
				fi
			fi
			row="$line"
		else
			row="$row$nl$line"
		fi
	done << EOF
$data
EOF

	if [ -n "$row" ]; then
		set_quoted_row_args "$row" "$num_args" "$remove_prefix"
		eval "$command $quoted_row_args"
		command_result="$?"

		if [ "$command_result" -ne 0 ]; then
			result="$command_result"
		fi
	fi

	return "$result"
}

append_root_dirs() {
	local path=

	for path; do
		if [ -n "$path" ]; then
			if [ -n "$root_dirs" ]; then
				root_dirs="$root_dirs$nl"
			fi
			root_dirs="$root_dirs$path"
		fi
	done
}

add_root_dirs() {
	local path=

	for path; do
		while str_includes "/./" "$path"; do
			path="${path%%/./*}/${path#*/./}"
		done

		if str_starts_with "/" "$path"; then
			path="/.$path"
		else
			path="././$path"
		fi

		append_root_dirs "$path"
	done
}

append_ignore_patterns() {
	local pattern=

	for pattern; do
		if [ -n "$pattern" ]; then
			if [ -n "$ignore_patterns" ]; then
				ignore_patterns="$ignore_patterns$nl"
			fi
			ignore_patterns="$ignore_patterns$pattern"
		fi
	done
}

add_ignore_patterns() {
	local pattern=

	for pattern; do
		append_ignore_patterns "././$pattern"
	done
}

build_ignore_arg() {
	local pattern="$1"
	local quoted_arg=

	if [ -z "$pattern" ]; then
		print_stderr "warning: not applying empty ignore pattern"
		return 1
	fi

	set_quoted_arg "$pattern"
	ignore_args="$ignore_args ! -name $quoted_arg "

	return 0
}

append_skip_patterns() {
	local pattern=

	for pattern; do
		if [ -n "$pattern" ]; then
			if [ -n "$skip_patterns" ]; then
				skip_patterns="$skip_patterns$nl"
			fi
			skip_patterns="$skip_patterns$pattern"
		fi
	done
}

add_skip_patterns() {
	local pattern=

	for pattern; do
		append_skip_patterns "././$pattern"
	done
}

build_skip_arg() {
	local pattern="$1"
	local quoted_arg=

	if [ -z "$pattern" ]; then
		print_stderr "warning: not applying empty skip pattern"
		return 1
	fi

	set_quoted_arg "$pattern"
	skip_args="$skip_args -name $quoted_arg -o "

	return 0
}

read_stdin() {
	if [ -z "$is_stdin_read" ]; then
		stdin_content="$("$sed" -e "\$a\\"; ret="$?"; printf 'EOF'; exit "$ret")"
		stdin_content="${stdin_content%EOF}"
		stdin_content="${stdin_content%"$nl"}"
		is_stdin_read=1
	fi
}

include_file() {
	local file_or_path="$1"
	local base_path="$2"
	local test_only="$3"
	local path=

	if [ -z "$file_or_path" ]; then
		return 1
	fi

	if [ "$file_or_path" = "-" ]; then
		if [ -n "$test_only" ]; then
			return 0
		fi

		printf '%s' "$stdin_content"
		return 0
	fi

	if str_includes "/" "$file_or_path"; then
		path="$file_or_path"
	else
		path="$base_path/$file_or_path"
	fi

	if [ ! -f "$path" ] || [ ! -r "$path" ]; then
		return 1
	fi

	if [ -n "$test_only" ]; then
		return 0
	fi

	cat -- "$path"
}

test_include_file() {
	include_file "$1" "$2" 1
}

print_generated_comment() {
	printf '\n<!-- Generated'
	printf ' at %s' "$now_text"
	printf ' by %s %s' "$pkg_name" "$pkg_version" | escape_html
	printf ' - %s' "$pkg_url" | escape_html
	printf ' -->'
}

print_html_index_breadcrumbs() {
	local rest_path="$index_path_prefix$rel_path"
	local cur_name=
	local cur_path=
	local first=1

	if ! str_ends_with "/" "$rest_path"; then
		rest_path="$rest_path/"
	fi

	printf '<ul class="breadcrumbs">'

	while [ -n "$rest_path" ]; do
		cur_name="${rest_path%%/*}"
		rest_path="${rest_path#*/}"

		cur_path="$cur_path$cur_name/"

		printf '<li>'

		if [ -n "$rest_path" ]; then
			printf '<a href="'; printf '%s' "$cur_path" | encode_uri; printf '">'
		else
			printf '<span>'
		fi

		if [ -n "$first" ]; then
			printf '%s' "$breadcrumbs_root_text" # no escape
		else
			printf '%s' "$cur_name" | escape_html
		fi

		if [ -n "$rest_path" ]; then
			printf '</a>'
		else
			printf '</span>'
		fi

		printf '</li>'

		first=
	done

	printf '</ul>'
}

print_html_index_item_data_attrs() {
	local item_type="$1"
	local mime_type="$2"
	local file_name="$3"

	if [ -n "$item_type" ]; then
		printf ' data-type="'; printf '%s' "$item_type" | escape_html; printf '" '
	fi

	if [ -n "$mime_type" ]; then
		printf ' data-mime-type="'; printf '%s' "$mime_type" | escape_html; printf '" '
	fi

	if [ -n "$file_name" ]; then
		printf ' data-file-name="'; printf '%s' "$file_name" | escape_html; printf '" '
	fi
}

print_html_index_table_header() {
	local column=
	local col_class=
	local col_text=

	printf '<table class="index index--table">'
	printf '<thead>'
	printf '<tr class="index__header">'

	while IFS= read -r column; do
		case "$column" in
			modified)
				col_class="index__col--last-modified"
				col_text="$last_modified_text"
				;;
			size)
				col_class="index__col--size"
				col_text="$size_text"
				;;
			*)
				col_class="index__col--name"
				col_text="$name_text"
				;;
		esac
		printf '<th class="'; printf '%s' "$col_class" | escape_html; printf '">'
		printf '%s' "$col_text" # no escape
		printf '</th>'
	done << EOF
$columns
EOF

	printf '</tr>'

	if [ -n "$rule_lines" ]; then
		printf '<tr class="index__separator">'
		printf '<td colspan="'; printf '%s' "$num_columns" | escape_html; printf '">'
		printf '<hr>'
		printf '</td>'
		printf '</tr>'
	fi

	printf '</thead>'

	printf '<tbody>'
}

print_html_index_table_row() {
	local item_type="$1"
	local url="$2"
	local name="$3"
	local size_formatted="$4"
	local last_modified_formatted="$5"
	local mime_type="$6"
	local file_name="$7"
	local column=

	printf '<tr class="index__item"'
	print_html_index_item_data_attrs "$item_type" "$mime_type" "$file_name"
	printf '>'

	while IFS= read -r column; do
		case "$column" in
			modified)
				printf '<td class="index__col--last-modified">'
				printf '%s' "$last_modified_formatted" # no escape
				printf '</td>'
				;;
			size)
				printf '<td class="index__col--size">'
				printf '%s' "$size_formatted" | escape_html
				printf '</td>'
				;;
			*)
				printf '<td class="index__col--name">'
				printf '<a href="'; printf '%s' "$url" | encode_uri; printf '">'
				printf '%s' "$name" | escape_html
				printf '</a>'
				printf '</td>'
				;;
		esac
	done << EOF
$columns
EOF

	printf '</tr>'
}

print_html_index_table_footer() {
	printf '</tbody>'

	if [ -n "$rule_lines" ]; then
		printf '<tfoot class="index__footer">'
		printf '<tr class="index__separator">'
		printf '<td colspan="'; printf '%s' "$num_columns" | escape_html; printf '">'
		printf '<hr>'
		printf '</td>'
		printf '</tr>'
		printf '</tfoot>'
	fi

	printf '</table>'
}

print_html_index_list_header() {
	printf '<ul class="index index--list">'
}

print_html_index_list_item() {
	local item_type="$1"
	local url="$2"
	local name="$3"
	local size_formatted="$4"
	local last_modified_formatted="$5"
	local mime_type="$6"
	local file_name="$7"

	printf '<li class="index__item"'
	print_html_index_item_data_attrs "$item_type" "$mime_type" "$file_name"
	printf '>'

	printf '<a href="'; printf '%s' "$url" | encode_uri; printf '">'
	printf '%s' "$name" | escape_html
	printf '</a>'

	printf '</li>'
}

print_html_index_list_footer() {
	printf '</ul>'
}

print_html_index_intro() {
	local display_path="$index_path_prefix$rel_path"
	local display_path_escaped=
	local parent_path=

	if [ "$display_path" != "/" ]; then
		display_path="${display_path%/}"
	fi

	if [ -n "$rel_path" ]; then
		parent_path="$index_path_prefix$rel_path"
		parent_path="${parent_path%/*}/"
	fi

	if [ -n "$html_preamble" ] || ! test_include_file "$header_path" "$index_dir"; then
		printf '<!DOCTYPE html>'
		printf '<html'
		if [ -n "$dir_text" ]; then
			printf ' dir="'; printf '%s' "$dir_text" | escape_html; printf '"'
		fi
		if [ -n "$lang_text" ]; then
			printf ' lang="'; printf '%s' "$lang_text" | escape_html; printf '"'
		fi
		printf '>'
		printf '<head>'

		if [ -n "$charset_text" ]; then
			printf '<meta charset="'; printf '%s' "$charset_text" | escape_html; printf '">'
		fi

		if [ -n "$title_text" ]; then
			printf '<title>'
			# shellcheck disable=SC2059 # title_text is a format string
			printf "$title_text" "$display_path" | escape_html
			printf '</title>'
		fi

		if test_include_file "$style_path"; then
			printf '<style>'
			include_file "$style_path"
			printf '</style>'
		fi

		if [ -n "$head_text" ]; then
			printf '%s' "$head_text" # no escape
		fi

		include_file "$head_path" "$index_dir"

		printf '</head>'

		printf '<body>'
	fi

	if ! include_file "$header_path" "$index_dir"; then
		if [ -n "$header_text" ]; then
			display_path_escaped="$(
				printf '%s\n' "$display_path" | escape_html
				ret="$?"; printf 'EOF'; exit "$ret"
			)"
			display_path_escaped="${display_path_escaped%EOF}"
			display_path_escaped="${display_path_escaped%"$nl"}"

			printf '<h1 class="header">'
			# shellcheck disable=SC2059 # header_text is a format string
			printf "$header_text" "$display_path_escaped" # no escape
			printf '</h1>'
		fi
	fi

	print_html_index_breadcrumbs

	if [ -z "$plain_list" ]; then
		print_html_index_table_header
	else
		print_html_index_list_header
	fi

	if [ -n "$parent_path" ]; then
		if [ -z "$plain_list" ]; then
			print_html_index_table_row "back" "$parent_path" "$parent_directory_text" "-"
		else
			print_html_index_list_item "back" "$parent_path" "$parent_directory_text" "-"
		fi
	fi
}

print_html_index_item() {
	local display_name="$name/"
	local item_type="folder"
	local mime_type=

	if [ "$type" = "f" ]; then
		display_name="$name"
		item_type="file"

		# $index_dir always starts with "/./" or "././"
		mime_type="$(file -bL --mime "$index_dir/$name")"

		if str_includes "/" "$mime_type"; then
			mime_type="${mime_type%%;*}"
		else
			mime_type=
		fi
	fi

	if [ -z "$plain_list" ]; then
		print_html_index_table_row "$item_type" "$display_name" "$display_name" \
			"$size_formatted" "$last_modified_formatted" "$mime_type" "$name"
	else
		print_html_index_list_item "$item_type" "$display_name" "$display_name" \
			"$size_formatted" "$last_modified_formatted" "$mime_type" "$name"
	fi
}

print_html_index_outro() {
	if [ -z "$plain_list" ]; then
		print_html_index_table_footer
	else
		print_html_index_list_footer
	fi

	if ! include_file "$readme_path" "$index_dir"; then
		if [ -n "$readme_text" ]; then
			printf '<address class="readme">'
			printf '%s' "$readme_text" # no escape
			printf '</address>'
		fi
	fi

	if [ -n "$html_preamble" ] || ! test_include_file "$readme_path" "$index_dir"; then
		printf '</body>'

		printf '</html>'
	fi

	print_generated_comment
}

print_xml_index_intro() {
	printf '<?xml version="1.0"'
	if [ -n "$encoding_text" ]; then
		printf ' encoding="'; printf '%s' "$encoding_text" | escape_html; printf '"'
	fi
	printf '?>'
	printf '<list>'
}

print_xml_index_item() {
	local tag="directory"

	if [ "$type" = "f" ]; then
		tag="file"
	fi

	printf '<%s' "$tag"
	printf ' mtime="'; printf '%s' "$last_modified_formatted" | escape_html; printf '"'
	if [ "$type" = "f" ]; then
		printf ' size="'; printf '%s' "$size" | escape_html; printf '"'
	fi
	printf '>'
	printf '%s' "$name" | escape_html
	printf '</%s>' "$tag"
}

print_xml_index_outro() {
	printf '</list>'

	print_generated_comment
}

print_json_index_intro() {
	printf '['
}

print_json_index_item() {
	local json_type="directory"

	if [ "$type" = "f" ]; then
		json_type="file"
	fi

	if [ -z "$first_item" ]; then
		printf ','
	fi

	printf '{'
	printf '"name":'; printf '%s' "$name" | encode_json_string
	printf ',"type":'; printf '%s' "$json_type" | encode_json_string
	printf ',"mtime":'; printf '%s' "$last_modified_formatted" | encode_json_string
	if [ "$type" = "f" ]; then
		printf ',"size":%s' "$size"
	fi
	printf '}'
}

print_json_index_outro() {
	printf ']'
}

print_index_item() {
	local type="$1"
	local name="$2"
	local size="$3"
	local size_formatted="$4"
	local last_modified="$5"
	local last_modified_formatted=

	case "$index_format" in
		xml)
			last_modified_formatted="$(
				printf '@%s' "$last_modified" | format_date_iso_8601
			)"
			print_xml_index_item
			;;
		json)
			last_modified_formatted="$(
				printf '@%s' "$last_modified" | format_date_iso_8601
			)"
			print_json_index_item
			;;
		*)
			# date adds a newline
			last_modified_formatted="$(
				printf '@%s' "$last_modified" | format_last_modified
				ret="$?"; printf 'EOF'; exit "$ret"
			)"
			last_modified_formatted="${last_modified_formatted%EOF}"
			last_modified_formatted="${last_modified_formatted%"$nl"}"
			print_html_index_item
			;;
	esac

	first_item=
}

generate_index() {
	local index_dir="$1"
	local rel_path=
	local index_data=
	local name_sort_options=
	local sort_col=
	local sort_options=
	local first_item=1
	local index_dir_mtime=
	local result=0

	if [ -z "$force" ] && [ -e "$index_dir/$index_file_name" ]; then
		return 0
	fi

	if [ "$index_dir" != "$root_dir" ]; then
		rel_path="${index_dir#"$root_dir"/}"
	fi

	eval "set -- $ignore_args"

	if [ -n "$name_version_sort" ]; then
		name_sort_options="${name_sort_options}V"
	fi
	if [ -n "$name_case_insensitive" ]; then
		name_sort_options="${name_sort_options}f"
	fi

	case "$sort_column" in
		modified)
			sort_col=7
			sort_options="n"
			;;
		size)
			sort_col=5
			sort_options="n"
			;;
		*)
			sort_col=4
			sort_options="$name_sort_options"
			;;
	esac

	if [ -n "$sort_desc" ]; then
		name_sort_options="${name_sort_options}r"
		sort_options="${sort_options}r"
	fi

	# columns:
	#   dot (.)
	#   dot (.)
	#   type (f/d)
	#   name (basename)
	#   size (bytes)
	#   size (formatted)
	#   last modified (epoch)

	# $index_dir always starts with "/./" or "././"
	index_data="$(
		"$find" -L "$index_dir/" \
			-mindepth 1 -maxdepth 1 \
			\( -type f -o \( -type d -executable \) \) \
			\! -name "$index_file_name" "$@" \
			-printf '././%y/%f/%s/%s/%T@\0' |
		"$numfmt" -z --to "$size_unit" -d / --field 6 |
		"$sed" -zE -e 's@^././d/([^/]+)/[^/]+/[^/]+/([^/]+)$@././d/\1/-1/-/\2@' |
		"$sort" -z -t / \
			${folders_first:+-k 3,3} \
			-k "$sort_col,$sort_col$sort_options" \
			-k "4,4$name_sort_options" |
		tr '\0' '\n'
	)"

	exec 3>"$temp_dir/$index_file_name"

	{
		case "$index_format" in
			xml)
				print_xml_index_intro
				;;
			json)
				print_json_index_intro
				;;
			*)
				print_html_index_intro
				;;
		esac

		if ! foreach_row "$index_data" 'print_index_item' 5 1; then
			result=1
		fi

		case "$index_format" in
			xml)
				print_xml_index_outro
				;;
			json)
				print_json_index_outro
				;;
			*)
				print_html_index_outro
				;;
		esac
	} >&3

	exec 3>&-

	if [ -n "$preserve_index_dir_mtime" ]; then
		index_dir_mtime="$(
			"$find" "$index_dir" -maxdepth 0 -printf '@%T@' | format_date_iso_8601
		)"
	fi

	rm -rf -- "${index_dir:?}/$index_file_name"
	mv -- "$temp_dir/$index_file_name" "$index_dir/"

	if [ -n "$index_dir_mtime" ]; then
		touch -m -d "$index_dir_mtime" -- "$index_dir"
	fi

	return "$result"
}

process_dir() {
	local root_dir="$1"
	local index_dirs=
	local result=0

	if [ "$root_dir" = "././" ]; then
		print_stderr "warning: not indexing empty path"
		return 1
	fi

	if [ ! -d "$root_dir" ] || [ ! -r "$root_dir" ] ||
			[ ! -w "$root_dir" ] || [ ! -x "$root_dir" ]; then
		if str_starts_with "/./" "$root_dir"; then
			root_dir="${root_dir#/.}"
		else
			root_dir="${root_dir#././}"
		fi
		print_stderr "warning: \"$root_dir\" is not an accessible directory"
		return 1
	fi

	while str_ends_with "/" "$root_dir"; do
		root_dir="${root_dir%/}"
	done

	eval "set -- $skip_args"

	# $root_dir always starts with "/./" or "././"
	index_dirs="$(
		{
			printf '%s\0' "$root_dir"
			"$find" "$root_dir/" \
				-mindepth 1 \
				-type d \( "$@" -false \) -prune -o \
				\( -type d -readable -writable -executable -print0 \)
		} |
		"$sort" -zr |
		tr '\0' '\n'
		ret="$?"; printf 'EOF'; exit "$ret"
	)"
	index_dirs="${index_dirs%EOF}"
	index_dirs="${index_dirs%"$nl"}"

	if ! foreach_row "$index_dirs" 'generate_index' 1; then
		result=1
	fi

	return "$result"
}

if gdate --version 2>&1 | grep -q coreutils; then
	date="gdate"
elif date --version 2>&1 | grep -q coreutils; then
	date="date"
else
	print_stderr "error: cannot find coreutils date"
	exit "$ex_unavailable"
fi

# shellcheck disable=SC2185 # not really finding
if gfind --version 2>&1 | grep -q findutils; then
	find="gfind"
elif find --version 2>&1 | grep -q findutils; then
	find="find"
else
	print_stderr "error: cannot find findutils find"
	exit "$ex_unavailable"
fi

if jq --version 2>&1 | grep -q jq; then
	jq="jq"
else
	print_stderr "error: cannot find jq"
	exit "$ex_unavailable"
fi

if gmktemp --version 2>&1 | grep -q coreutils; then
	mktemp="gmktemp"
elif mktemp --version 2>&1 | grep -q coreutils; then
	mktemp="mktemp"
else
	print_stderr "error: cannot find coreutils mktemp"
	exit "$ex_unavailable"
fi

if gnumfmt --version 2>&1 | grep -q coreutils; then
	numfmt="gnumfmt"
elif numfmt --version 2>&1 | grep -q coreutils; then
	numfmt="numfmt"
else
	print_stderr "error: cannot find coreutils numfmt"
	exit "$ex_unavailable"
fi

if greadlink --version 2>&1 | grep -q coreutils; then
	readlink="greadlink"
elif readlink --version 2>&1 | grep -q coreutils; then
	readlink="readlink"
else
	print_stderr "error: cannot find coreutils readlink"
	exit "$ex_unavailable"
fi

if grealpath --version 2>&1 | grep -q coreutils; then
	realpath="grealpath"
elif realpath --version 2>&1 | grep -q coreutils; then
	realpath="realpath"
else
	print_stderr "error: cannot find coreutils realpath"
	exit "$ex_unavailable"
fi

if gsed --version 2>&1 | grep -q GNU; then
	sed="gsed"
elif sed --version 2>&1 | grep -q GNU; then
	sed="sed"
else
	print_stderr "error: cannot find GNU sed"
	exit "$ex_unavailable"
fi

if gsort --version 2>&1 | grep -q coreutils; then
	sort="gsort"
elif sort --version 2>&1 | grep -q coreutils; then
	sort="sort"
else
	print_stderr "error: cannot find coreutils sort"
	exit "$ex_unavailable"
fi

while getopts A:C:d:D:e:E:fFg:G:hH:i:I:k:K:l:m:M:N:o:O:P:r:R:s:S:t:T:uVw:W:x:X:y:z:Z: OPT; do
	case $OPT in
		A)
			charset_text="$OPTARG"
			;;
		C)
			columns=
			num_columns=0
			OPTARG="$OPTARG,"
			while [ -n "$OPTARG" ]; do
				keyword="${OPTARG%%,*}"
				case "$keyword" in
					name|modified|size)
						if [ -n "$columns" ]; then
							columns="$columns$nl"
						fi
						columns="$columns$keyword"
						num_columns="$((num_columns + 1))"
						;;
					*)
						print_stderr "error: \"$keyword\" is not a valid column"
						exit "$ex_usage"
						;;
				esac
				OPTARG="${OPTARG#*,}"
			done
			if ! str_includes "name" "$columns"; then
				print_stderr "error: name column must be included"
				exit "$ex_usage"
			fi
			;;
		d)
			header_text="$OPTARG"
			;;
		D)
			header_path="$OPTARG"
			;;
		e)
			head_text="$head_text$OPTARG"
			;;
		E)
			head_path="$OPTARG"
			;;
		f)
			force=1
			;;
		F)
			preserve_index_dir_mtime=
			;;
		g)
			root_dirs_path="$OPTARG"
			;;
		G)
			encoding_text="$OPTARG"
			;;
		h)
			usage
			exit 0
			;;
		H)
			OPTARG="$OPTARG,"
			while [ -n "$OPTARG" ]; do
				keyword="${OPTARG%%,*}"
				case "$keyword" in
					table)
						plain_list=
						;;
					list)
						plain_list=1
						;;
					rules)
						rule_lines=1
						;;
					no-rules)
						rule_lines=
						;;
					preamble)
						html_preamble=1
						;;
					no-preamble)
						html_preamble=
						;;
					*)
						print_stderr "error: \"$keyword\" is not a valid HTML output option"
						exit "$ex_usage"
						;;
				esac
				OPTARG="${OPTARG#*,}"
			done
			;;
		i)
			if str_includes "/" "$OPTARG"; then
				print_stderr "warning: removing leading directories of ignore pattern \"$OPTARG\""
				result=1
			fi
			add_ignore_patterns "${OPTARG##*/}"
			;;
		I)
			ignore_patterns_path="$OPTARG"
			;;
		k)
			if str_includes "/" "$OPTARG"; then
				print_stderr "warning: removing leading directories of skip pattern \"$OPTARG\""
				result=1
			fi
			add_skip_patterns "${OPTARG##*/}"
			;;
		K)
			skip_patterns_path="$OPTARG"
			;;
		l)
			lang_text="$OPTARG"
			;;
		m)
			last_modified_format="$OPTARG"
			;;
		M)
			last_modified_text="$OPTARG"
			;;
		N)
			name_text="$OPTARG"
			;;
		o)
			index_file_name="$OPTARG"
			;;
		O)
			case "$OPTARG" in
				html|xml|json)
					index_format="$OPTARG"
					;;
				*)
					print_stderr "error: \"$OPTARG\" is not a valid output format"
					exit "$ex_usage"
					;;
			esac
			;;
		P)
			parent_directory_text="$OPTARG"
			;;
		r)
			readme_text="$OPTARG"
			;;
		R)
			readme_path="$OPTARG"
			;;
		s)
			case "$OPTARG" in
				name|modified|size)
					sort_column="$OPTARG"
					;;
				*)
					print_stderr "error: \"$OPTARG\" is not a valid sort column"
					exit "$ex_usage"
					;;
			esac
			;;
		S)
			OPTARG="$OPTARG,"
			while [ -n "$OPTARG" ]; do
				keyword="${OPTARG%%,*}"
				case "$keyword" in
					asc|ascending)
						sort_desc=
						;;
					desc|descending)
						sort_desc=1
						;;
					version)
						name_version_sort=1
						;;
					no-version)
						name_version_sort=
						;;
					case)
						name_case_insensitive=
						;;
					no-case)
						name_case_insensitive=1
						;;
					folders-first)
						folders_first=1
						;;
					no-folders-first)
						folders_first=
						;;
					*)
						print_stderr "error: \"$keyword\" is not a valid sort option"
						exit "$ex_usage"
						;;
				esac
				OPTARG="${OPTARG#*,}"
			done
			;;
		t)
			title_text="$OPTARG"
			;;
		T)
			OPTARG="$OPTARG,"
			while [ -n "$OPTARG" ]; do
				keyword="${OPTARG%%,*}"
				case "$keyword" in
					ignore-dot)
						ignore_dot_files=1
						;;
					no-ignore-dot)
						ignore_dot_files=
						;;
					ignore-includes)
						ignore_html_includes=1
						;;
					no-ignore-includes)
						ignore_html_includes=
						;;
					*)
						print_stderr "error: \"$keyword\" is not a valid ignore pattern option"
						exit "$ex_usage"
						;;
				esac
				OPTARG="${OPTARG#*,}"
			done
			;;
		u)
			last_modified_utc=1
			;;
		V)
			printf '%s %s\n' "$pkg_name" "$pkg_version"
			exit 0
			;;
		w)
			dir_text="$OPTARG"
			;;
		W)
			OPTARG="$OPTARG,"
			while [ -n "$OPTARG" ]; do
				keyword="${OPTARG%%,*}"
				case "$keyword" in
					skip-dot)
						skip_dot_dirs=1
						;;
					no-skip-dot)
						skip_dot_dirs=
						;;
					skip-ignores)
						skip_ignore_patterns=1
						;;
					no-skip-ignores)
						skip_ignore_patterns=
						;;
					*)
						print_stderr "error: \"$keyword\" is not a valid skip pattern option"
						exit "$ex_usage"
						;;
				esac
				OPTARG="${OPTARG#*,}"
			done
			;;
		x)
			breadcrumbs_root_text="$OPTARG"
			;;
		X)
			index_path_prefix="$OPTARG"
			;;
		y)
			style_name="$OPTARG"
			;;
		z)
			case "$OPTARG" in
				none|si|iec|iec-i)
					size_unit="$OPTARG"
					;;
				*)
					print_stderr "error: \"$OPTARG\" is not a valid file size unit"
					exit "$ex_usage"
					;;
			esac
			;;
		Z)
			size_text="$OPTARG"
			;;
		\?)
			usage
			exit "$ex_usage"
			;;
	esac
done

shift "$((OPTIND - 1))"

add_root_dirs "$@"

if [ -n "$root_dirs_path" ] &&
		{ [ "$root_dirs_path" != "-" ] || [ -z "$is_stdin_read" ]; }; then
	ensure_readable_file "$root_dirs_path"

	file_data="$(
		"$sed" -zE \
			-e 's@/\./@/@g' \
			-e 's@^/@/./@' \
			-e 's@^([^/])@././\1@' \
			-e 's@^$@././@' \
			-e "\$a\\" \
			-- "$root_dirs_path" |
		tr '\0' '\n'
		ret="$?"; printf 'EOF'; exit "$ret"
	)"
	file_data="${file_data%EOF}"
	file_data="${file_data%"$nl"}"

	append_root_dirs "$file_data"

	if [ "$root_dirs_path" = "-" ]; then
		is_stdin_read=1
	fi
fi

if [ -z "$root_dirs" ]; then
	usage
	exit "$ex_usage"
fi

for path in "$head_path" "$header_path" "$readme_path"; do
	if str_includes "/" "$path"; then
		ensure_readable_file "$path"
	fi
done

if [ -n "$style_name" ] && [ "$style_name" != "none" ]; then
	path="$xdg_data_home/$pkg_tarname/styles/$style_name.css"
	if [ -f "$path" ] && [ -r "$path" ]; then
		style_path="$path"
	fi

	if [ -z "$style_path" ]; then
		search_paths="$xdg_data_dirs:"
		while [ -n "$search_paths" ]; do
			path="${search_paths%%:*}"
			search_paths="${search_paths#*:}"

			if [ -z "$path" ]; then
				continue
			fi

			path="$path/$pkg_tarname/styles/$style_name.css"
			if [ -f "$path" ] && [ -r "$path" ]; then
				style_path="$path"
				break
			fi
		done
	fi

	if [ -z "$style_path" ]; then
		search_paths="$("$readlink" -e "$source"; ret="$?"; printf 'EOF'; exit "$ret")"
		search_paths="${search_paths%EOF}"
		search_paths="${search_paths%"$nl"}"

		search_paths="/.${search_paths%/*}"
		search_paths="${search_paths%/*}"
		while [ -n "$search_paths" ]; do
			path="$search_paths/share/$pkg_tarname/styles/$style_name.css"
			if [ -f "$path" ] && [ -r "$path" ]; then
				style_path="$path"
				break
			fi
			search_paths="${search_paths%/*}"
		done
	fi

	if [ -z "$style_path" ]; then
		print_stderr "error: cannot find style \"$style_name\""
		exit "$ex_noinput"
	fi
fi

for signal in "EXIT" "HUP" "INT" "QUIT" "TERM"; do
	# shellcheck disable=SC2064
	trap "clean_up $signal" "$signal"
done

temp_dir="$("$mktemp" -d --tmpdir "$me-XXXXXXXXXX")" || {
	print_stderr "error: cannot create temporary directory"
	exit "$ex_unavailable"
}

now_text="$("$date" -u "+$iso_8601_format")"

if [ -z "$index_file_name" ]; then
	index_file_name="index.$index_format"
fi

index_path_prefix="$(
	"$realpath" -ms "/$index_path_prefix"
	ret="$?"; printf 'EOF'; exit "$ret"
)"
index_path_prefix="${index_path_prefix%EOF}"
index_path_prefix="${index_path_prefix%"$nl"}"

if ! str_ends_with "/" "$index_path_prefix"; then
	index_path_prefix="$index_path_prefix/"
fi

if [ -n "$ignore_dot_files" ]; then
	add_ignore_patterns ".*"
fi

if [ "$index_format" = "html" ] && [ -n "$ignore_html_includes" ]; then
	for path in "$head_path" "$header_path" "$readme_path"; do
		if [ -n "$path" ] && ! str_includes "/" "$path"; then
			add_ignore_patterns "$path"
		fi
	done
fi

if [ -n "$ignore_patterns_path" ] &&
		{ [ "$ignore_patterns_path" != "-" ] || [ -z "$is_stdin_read" ]; }; then
	ensure_readable_file "$ignore_patterns_path"

	file_data="$(
		"$sed" -zE \
			-e 's@.*/@@g' \
			-e 's@^@././@' \
			-e "\$a\\" \
			-- "$ignore_patterns_path" |
		tr '\0' '\n'
		ret="$?"; printf 'EOF'; exit "$ret"
	)"
	file_data="${file_data%EOF}"
	file_data="${file_data%"$nl"}"

	append_ignore_patterns "$file_data"

	if [ "$ignore_patterns_path" = "-" ]; then
		is_stdin_read=1
	fi
fi

if ! foreach_row "$ignore_patterns" 'build_ignore_arg' 1 1; then
	result=1
fi

if [ -n "$skip_dot_dirs" ]; then
	add_skip_patterns ".*"
fi

if [ -n "$skip_ignore_patterns" ]; then
	append_skip_patterns "$ignore_patterns"
fi

if [ -n "$skip_patterns_path" ] &&
		{ [ "$skip_patterns_path" != "-" ] || [ -z "$is_stdin_read" ]; }; then
	ensure_readable_file "$skip_patterns_path"

	file_data="$(
		"$sed" -zE \
			-e 's@.*/@@g' \
			-e 's@^@././@' \
			-e "\$a\\" \
			-- "$skip_patterns_path" |
		tr '\0' '\n'
		ret="$?"; printf 'EOF'; exit "$ret"
	)"
	file_data="${file_data%EOF}"
	file_data="${file_data%"$nl"}"

	append_skip_patterns "$file_data"

	if [ "$skip_patterns_path" = "-" ]; then
		is_stdin_read=1
	fi
fi

if ! foreach_row "$skip_patterns" 'build_skip_arg' 1 1; then
	result=1
fi

if [ -z "$is_stdin_read" ]; then
	for path in "$head_path" "$header_path" "$readme_path"; do
		if [ "$path" = "-" ]; then
			read_stdin
			break
		fi
	done
fi

if ! foreach_row "$root_dirs" 'process_dir' 1; then
	result=1
fi

exit "$result"
